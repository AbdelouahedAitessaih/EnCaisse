rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupCreator(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          == request.auth.uid;
    }

    function validProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'displayName', 'email', 'photoUrl', 'createdAt', 'fcmToken',
        'fcmTokens', 'fcmTokenUpdatedAt', 'movementSuccessCount',
        'groupsCreatedCount', 'activityNotificationsEnabled',
        'remindersEnabled', 'lastActiveAt', 'timeZone'
      ]);
    }

    match /users/{uid} {
      allow read: if ownsUser(uid);
      allow create: if ownsUser(uid) && validProfileKeys();
      // On update only the changed keys matter. Re-checking the whole document
      // against validProfileKeys() broke every client write the moment the
      // server added a field outside that list, so keep the affectedKeys check
      // alone here.
      allow update: if ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoUrl', 'createdAt', 'fcmToken',
          'fcmTokens', 'fcmTokenUpdatedAt', 'movementSuccessCount',
          'groupsCreatedCount', 'activityNotificationsEnabled',
          'remindersEnabled', 'lastActiveAt', 'timeZone'
        ]);
      allow delete: if false;

      match /memberships/{groupId} {
        allow read: if ownsUser(uid);
        allow create: if false;
        allow update: if (isGroupCreator(groupId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'isPersonal']))
          || (ownsUser(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastViewedAt'])
            && request.resource.data.lastViewedAt is timestamp);
        allow delete: if ownsUser(uid) || isGroupCreator(groupId);
      }

      match /notifications/{notifId} {
        allow read: if ownsUser(uid);
        allow create, delete: if false;
        allow update: if ownsUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read'])
          && request.resource.data.read is bool;
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if false;
      allow update: if isGroupCreator(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && (!('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl is string);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isGroupMember(groupId);
        allow create: if false;
        allow update: if ownsUser(uid)
          && isGroupMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoUrl', 'notificationsMuted'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.notificationsMuted is bool;
        allow delete: if signedIn() && (
          (request.auth.uid == uid
            && uid != get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy)
          || isGroupCreator(groupId)
        );
      }

      match /movements/{movementId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /audit/{auditId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /recurring/{ruleId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // Server-side replay bookkeeping only. Denied to clients explicitly so a
      // future rule change cannot accidentally expose it.
      match /settlementGuards/{pairId} {
        allow read, write: if false;
      }
    }
  }
}
