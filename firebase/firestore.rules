rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupCreator(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          == request.auth.uid;
    }

    function isStartingBalance() {
      return resource.data.get('isStartingBalance', false) == true;
    }

    function willBeStartingBalance() {
      return request.resource.data.get('isStartingBalance', false) == true;
    }

    function groupCoreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // Owner may update their profile (name, photo, fcmToken, repair missing fields).
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /memberships/{groupId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && (request.auth.uid == uid || isGroupCreator(groupId));
        allow delete: if signedIn()
          && (request.auth.uid == uid || isGroupCreator(groupId));
      }

      match /notifications/{notifId} {
        allow read, update: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn();
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /groups/{groupId} {
      allow get: if signedIn();
      allow list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'createdBy', 'createdAt', 'inviteCode', 'currency'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string
        && request.resource.data.currency is string;

      // Creator may change name and/or photoUrl.
      allow update: if isGroupCreator(groupId)
        && groupCoreUnchanged()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;

      allow delete: if isGroupCreator(groupId);

      match /members/{uid} {
        allow read: if signedIn()
          && (request.auth.uid == uid || isGroupMember(groupId));
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
          && (request.auth.uid == uid || isGroupMember(groupId));
        // Creator may delete any member (including self when deleting the group).
        // Other members may only delete themselves (leave); never the creator.
        allow delete: if signedIn() && (
          isGroupCreator(groupId)
          || (
            request.auth.uid == uid
            && uid != get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          )
        );
      }

      match /movements/{movementId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && (!willBeStartingBalance() || isGroupCreator(groupId));

        allow update: if isGroupMember(groupId)
          && (!isStartingBalance() || isGroupCreator(groupId))
          && (
            !isStartingBalance()
            || request.resource.data.isStartingBalance == true
          );

        allow delete: if isGroupCreator(groupId);
      }

      match /audit/{auditId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update: if false;
        allow delete: if isGroupCreator(groupId);
      }
    }
  }
}
