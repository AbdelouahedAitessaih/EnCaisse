rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function isGroupCreator(groupId) {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/groups/$(groupId)
        ).data.createdBy == request.auth.uid;
    }

    match /users/{uid}/avatar.jpg {
      // Avatar URLs are shared in group member profiles. Access still requires
      // authentication, and the path is limited to the avatar object.
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && isImage();
      allow delete: if false;
    }

    match /groups/{groupId}/cover.jpg {
      allow read: if isGroupMember(groupId);
      allow create, update: if isGroupCreator(groupId) && isImage();
      allow delete: if false;
    }

    match /groups/{groupId}/receipts/{fileName} {
      allow read: if isGroupMember(groupId);
      allow create, update: if isGroupMember(groupId)
        && fileName.matches('^[A-Za-z0-9_-]+\\.jpg$')
        && isImage();
      allow delete: if false;
    }
  }
}
